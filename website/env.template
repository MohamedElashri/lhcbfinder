# ChromaDB Configuration
# Path to ChromaDB database directory
# For Docker: /app/chroma_db (mounted volume)
# For local dev: ../model/output/chroma_db or absolute path
CHROMA_DB_PATH=../model/output/chroma_db

# Flask Configuration
FLASK_ENV=production
FLASK_APP=app.py

# Redis Configuration (for rate limiting)
# Use memory:// for development, redis://redis:6379/0 for production
REDIS_URL=memory://

# Search Configuration
# Number of abstracts to fetch from ChromaDB
SEARCH_ABSTRACT_LIMIT=20
# Number of content chunks to fetch (when content search enabled)
SEARCH_CONTENT_LIMIT=100
# Maximum number of results to return to frontend
SEARCH_MAX_RESULTS=20